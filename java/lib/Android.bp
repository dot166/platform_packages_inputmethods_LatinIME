cc_prebuilt_library_shared {
    name: "libmozc",
    product_specific: true,
    shared_libs: ["libc", "libdl", "liblog", "libm"],
    target: {
        android_arm64: {
            srcs: ["arm64-v8a/libmozc.so"],
        },
        android_x86_64: {
            srcs: ["x86_64/libmozc.so"],
        },
        android_arm: {
            srcs: ["armeabi-v7a/libmozc.so"],
        },
        android_x86: {
            srcs: ["x86/libmozc.so"],
        },
    },
    strip: {
        none:true,
    },
}
